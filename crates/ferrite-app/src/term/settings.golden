set 0 3 1 4 Monitor               # Trigger
set 0 5 8 Cable                   # KISS TNC
set 0 6 3 DMS                     # Coordinates
set 0 6 4 Imperial                # Units
set 0 6 5 UTC+5:30                # Time zone
set 0 6 8 Transmit                # GPS off during
set 0 7 1 Night red               # Theme
set 0 7 2 Single + scope          # Layout
set 0 7 3 2 Callsign              # Power-on text
set 0 7 4 1 5 min                 # Timeout
set 0 7 4 2 1                     # Brightness
set 0 7 4 4 Keys and RX           # Wake on
set 0 7 4 5 On key press          # Key light
set 0 7 5 2 High                  # Beep volume
set 0 7 6 RX and TX               # LEDs
set 0 7 8 Off                     # Auto power off
set 0 8 2 2 9                     # Level
set 0 8 2 3 3 s                   # Tail
set 0 8 4 Chirp                   # End tone
set 0 8 5 3 200 ms                # Speed
set 0 8 5 5 1000 ms               # Start delay
set 0 8 6 2 Every 10 min          # CW ID
set 0 8 8 1 Normal                # Subtone level
set 0 8 8 2 Transmit              # Tail removal
set 0 8 8 3 180°                 # Phase
set 0 9 1 1 Off                   # Auto lock
set 0 9 2 3 Link                  # Cable port
